# Copy this file to `.env` (repo root). docker compose auto-loads it and substitutes
# the values into the api service. NEVER commit .env (already gitignored).
#
# Leave everything as-is to keep running against local MinIO (zero-setup dev).
# Fill in the AWS values to switch media storage to real S3.

# ---------------- S3 backend ----------------
# Local MinIO defaults:
S3_ENDPOINT=minio:9000
S3_PUBLIC_ENDPOINT=localhost:9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_ACCESS_KEY=fusion-dev
S3_SECRET_KEY=fusion-dev-secret
S3_BUCKET=fusion-media

# Real AWS example (replace all of the above with these shapes):
# S3_ENDPOINT=s3.us-west-2.amazonaws.com
# S3_PUBLIC_ENDPOINT=s3.us-west-2.amazonaws.com
# S3_USE_SSL=true
# S3_REGION=us-west-2
# S3_ACCESS_KEY=AKIA...            (IAM user fusion-photos-api-dev)
# S3_SECRET_KEY=<the secret half>
# S3_BUCKET=fusion-photos-media-dev-<yoursuffix>

# ---------------- API ----------------
DEV_MODE=true           # keep true until SES/SNS OTP is wired
QUOTA_BYTES=2147483648  # 2 GiB dev quota

# ---------------- OTP / email ----------------
# Leave SES_ENABLED=false for local dev: codes are returned as `devCode` and never
# emailed. For a real deployment set it true, verify a sender domain in SES, and
# grant the API role ses:SendEmail.
SES_ENABLED=false
SES_REGION=us-east-1
SES_FROM=no-reply@your-domain.example

# OTP_PEPPER keys the HMAC that hashes sign-in codes at rest. Generate a random
# 32-byte value (`openssl rand -hex 32`) and set it in production so pending codes
# survive a restart and are useless if the database leaks. Empty = ephemeral pepper.
OTP_PEPPER=

# Lifecycle / abuse limits (Go duration syntax: 10m, 15m, 1h).
OTP_TTL=10m              # how long a code stays valid
OTP_MAX_ATTEMPTS=5       # wrong guesses before the code is invalidated
OTP_PER_EMAIL_LIMIT=5    # codes per email per window
OTP_PER_EMAIL_WINDOW=15m
OTP_PER_IP_LIMIT=200     # requests per IP per window (raise behind a shared NAT)
OTP_PER_IP_WINDOW=1h

# ---------------- Independent replica (disaster copy) ----------------
# Empty S3_REPLICA_BUCKET = no replica = the service NEVER claims "protected remotely".
# Dev: a second bucket on the same MinIO (docker-compose default sets fusion-media-replica).
# Prod: a bucket in a second region / separate AWS account; set the S3_REPLICA_* creds
# explicitly for cross-account access (see infra/ for the replication + IAM setup).
# S3_REPLICA_BUCKET=
# S3_REPLICA_ENDPOINT=
# S3_REPLICA_ACCESS_KEY=
# S3_REPLICA_SECRET_KEY=
# S3_REPLICA_REGION=us-west-2

# Scheduled workers (Go duration syntax).
REPLICATION_INTERVAL=15m  # how often to re-verify replica objects
RECONCILE_INTERVAL=1h     # expire abandoned uploads, prune auth tables
